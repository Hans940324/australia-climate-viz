{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 680,
  "height": 420,
  "background": "#fafaf7",
  "data": {"url": "../data/melb_daily_sun_tmax.csv"},
  "layer": [
    {
      "mark": {"type": "point", "filled": true, "size": 22, "opacity": 0.45, "strokeWidth": 0},
      "encoding": {
        "x": {
          "field": "sun_hr",
          "type": "quantitative",
          "title": "Daily sunshine duration (hours)",
          "scale": {"domain": [0, 15], "nice": false},
          "axis": {"labelFontSize": 11, "titleFontSize": 12}
        },
        "y": {
          "field": "tmax",
          "type": "quantitative",
          "title": "Daily maximum temperature (°C)",
          "scale": {"domain": [5, 46], "nice": false},
          "axis": {"labelFontSize": 11, "titleFontSize": 12}
        },
        "color": {
          "field": "season",
          "type": "nominal",
          "scale": {
            "domain": ["Summer", "Autumn", "Winter", "Spring"],
            "range": ["#d7563d", "#ee964b", "#1d4877", "#3a9d7c"]
          },
          "legend": {"title": "Season", "orient": "top-left", "labelFontSize": 11, "titleFontSize": 12, "symbolOpacity": 1, "symbolSize": 100, "fillColor": "#fafaf7", "padding": 6}
        },
        "tooltip": [
          {"field": "date", "type": "nominal"},
          {"field": "sun_hr", "type": "quantitative", "title": "Sunshine (hr)", "format": ".2f"},
          {"field": "tmax", "type": "quantitative", "title": "Max temp (°C)", "format": ".1f"},
          {"field": "season", "type": "nominal"}
        ]
      }
    },
    {
      "transform": [{"regression": "tmax", "on": "sun_hr"}],
      "mark": {"type": "line", "color": "#1a1a1a", "size": 2.5, "strokeDash": [6, 4]},
      "encoding": {
        "x": {"field": "sun_hr", "type": "quantitative"},
        "y": {"field": "tmax", "type": "quantitative"}
      }
    },
    {
      "data": {
        "values": [
          {"x": 11.0, "y": 8.0, "text": "Pearson r = 0.47  (n = 7,425 days)", "align": "left"},
          {"x": 1.5, "y": 11.5, "text": "Overcast winter days →", "align": "left"},
          {"x": 12.0, "y": 44.5, "text": "← Heatwaves: long sun + extreme heat", "align": "left"}
        ]
      },
      "mark": {"type": "text", "fontSize": 11, "fontStyle": "italic", "color": "#222"},
      "encoding": {
        "x": {"field": "x", "type": "quantitative"},
        "y": {"field": "y", "type": "quantitative"},
        "text": {"field": "text", "type": "nominal"},
        "align": {"field": "align", "type": "nominal", "scale": null, "legend": null}
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "font": "system-ui, -apple-system, Segoe UI, sans-serif",
    "axis": {"grid": true, "gridColor": "#eee", "domainColor": "#888", "tickColor": "#888"}
  }
}
